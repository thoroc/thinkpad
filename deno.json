{
  "tasks": {
    "dev": "deno run --watch -A api/thinkpad.ts",
    "start": "deno run -A api/thinkpad.ts",
    "test": "deno test -A --unstable",
    "deploy": "denoctl deploy --entry-point api/thinkpad.ts --name thinkpad",
    "data": "deno run --allow-read --allow-write --allow-env --allow-sys ./opt/scripts/main.ts"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.6.17",
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.4.2",
    "@psych/sheet": "jsr:@psych/sheet@^1.0.6",
    "@std/assert": "jsr:@std/assert@1",
    "@std/fs": "jsr:@std/fs@^1.0.9",
    "chalk": "npm:chalk@^5.4.1",
    "figlet": "npm:figlet@^1.8.0",
    "quicktype": "npm:quicktype@^23.0.170",
    "quicktype-core": "npm:quicktype-core@^23.0.170",
    "string-ts": "npm:string-ts@^2.2.0",
    "ts-to-zod": "npm:ts-to-zod@^3.15.0",
    "zod": "npm:zod@^3.24.1"
  }
}